{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Still",
  "scopeName": "source.still",
  "patterns": [{ "include": "#all" }],
  "repository": {
    "all": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#decorator" },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#keyword" },
        { "include": "#type" },
        { "include": "#builtin" },
        { "include": "#operator" },
        { "include": "#ident" }
      ]
    },
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.still"
    },
    "decorator": {
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*",
      "name": "entity.other.attribute-name.still"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.still",
      "patterns": [
        { "match": "\\\\[ntr0\\\\\"']", "name": "constant.character.escape.still" },
        { "match": "\\{\\{", "name": "constant.character.escape.still" },
        { "match": "\\}\\}", "name": "constant.character.escape.still" },
        {
          "begin": "\\{",
          "end": "\\}",
          "name": "meta.embedded.expression.still",
          "patterns": [{ "include": "#all" }]
        }
      ]
    },
    "number": {
      "match": "\\b(0x[0-9a-fA-F_]+|0o[0-7_]+|0b[01_]+|[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?)\\b",
      "name": "constant.numeric.still"
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(func|type|extern|use|as)\\b",
          "name": "storage.type.still"
        },
        {
          "match": "\\b(if|elif|else|while|for|in|and|or|not|is)\\b",
          "name": "keyword.control.still"
        },
        {
          "match": "\\b(return|break|continue|pass)\\b",
          "name": "keyword.control.flow.still"
        },
        {
          "match": "\\b(true|false|none)\\b",
          "name": "constant.language.still"
        },
        {
          "match": "\\bself\\b",
          "name": "variable.language.still"
        }
      ]
    },
    "type": {
      "match": "\\b(int|float|bool|str|none)\\b(\\?)?",
      "name": "support.type.primitive.still"
    },
    "builtin": {
      "match": "\\b(print|len|push|pop|keys|pairs|str|int|float|bool|abs|min|max|sum|range|enumerate|reversed|type_of|input|clock|rand|seed|check|fail|exit|ord|chr|read_file|write_file|get_env|sleep_ms)\\b",
      "name": "support.function.builtin.still"
    },
    "operator": {
      "match": "(\\+\\+|\\+|-|\\*\\*|\\*|//|/|%|==|!=|<=|>=|<|>|=|\\+=|-=|\\*=|/=|//=)",
      "name": "keyword.operator.still"
    },
    "ident": {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
      "name": "meta.identifier.still"
    }
  }
}
