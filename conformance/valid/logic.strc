print(true and false)
print(true or false)
print(not true)
print(1 and 2)
print(0 or 5)
print("" or "fallback")
print(none or "d")
t = true
f = false
print(t and not f)
print(1 < 2, 2 <= 2, 3 > 2, 3 >= 4)
print(1 == 1.0)
print("a" < "b")
print([1, 2] == [1, 2])
print([1, 2] == [1, 3])
print({"a": 1} == {"a": 1})
v = 0
if not v:
    print("zero is falsy")
s = ""
if not s:
    print("empty str is falsy")
l: [int] = []
if not l:
    print("empty list is falsy")
