x = 2
match x:
    case 1, 3:
        print("odd")
    case 2:
        print("two")
    case -2:
        print("neg two")
    case _:
        print("other")

s = "hi"
match s:
    case "yo", "why":
        print("o/w")
    case "hi":
        print("hello")

match x:
    case 7:
        print("seven")

match s:
    case "bye":
        print("bye")
    case _:
        print("fallback")

print("done")
