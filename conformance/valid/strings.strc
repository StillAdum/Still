s = "Hello, Still World"
print(s.len())
print(s.upper())
print(s.lower())
print(s.trim())
t = "  pad  "
print("[{t.trim()}]")
print(s.contains("Still"))
print(s.starts("Hello"))
print(s.ends("World"))
print(s[0])
print(s[-1])
print(s[7:12])
print(s[:5])
print(s[-5:])
words = s.split(" ")
print(len(words), words[0], words[2])
print("Still" in s)
print("nope" not in s)
print("a" + "b" + "c")
print(str(42) + "!")
print(int("123") + 1)
print(float("2.5") * 2)
print("{s} has {len(s)} chars")
