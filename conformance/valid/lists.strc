nums = [3, 1, 4, 1, 5]
print(len(nums))
print(nums[0], nums[-1])
nums.push(9)
print(nums)
print(nums.pop())
print(len(nums))
nums[0] = 100
print(nums[0])
print(nums[1:3])
print(nums[:2])
print(nums[-2:])
copy = nums + [7, 7]
print(len(copy))
print(4 in nums)
print(99 not in nums)
mixed = [1, 2.5]
print(type_of(mixed))
empty: [int] = []
empty.push(1)
print(empty)
total = 0
for n in nums:
    total += n
print(total)
print(sum(nums))
print(min(nums), max(nums))
print(reversed(nums))
i = 0
while i < 3:
    print(i, nums[i])
    i += 1
    if i == 2:
        break
nums.clear()
print(len(nums))
