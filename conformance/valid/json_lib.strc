use json

r = json.parse("{{\"name\": \"still\", \"n\": 42, \"pi\": 3.5, \"ok\": true, \"xs\": [1, 2, 3], \"sub\": {{\"deep\": \"yes\"}}, \"nil\": null}}")
print(r.ok, r.error == "")
v = r.value
print(json.get_str(v, "name", "?"))
print(json.get_int(v, "n", 0))
print(json.get_float(v, "pi", 0.0))
print(json.get_bool(v, "ok", false))
xs = json.get_list(v, "xs")
print(len(xs), xs[0], xs[2])
sub = json.get_dict(v, "sub")
print(json.get_str(sub, "deep", "no"))
print(json.get_any(v, "nil") is none)
print(json.get_str(v, "missing", "fallback"))
print(json.stringify(v))
print(json.valid("not json"))
bad = json.parse("{{\"a\":}}")
print(bad.ok)
esc = json.parse("\"a\\nb\\u0041\"")
print(esc.value)
print(json.stringify(esc.value))
nums = json.parse("[1.5e2, -7, 0.25]")
print(nums.value[0], nums.value[1], nums.value[2])
print(json.stringify_pretty(json.parse("{{\"a\": [true, false]}}").value))
