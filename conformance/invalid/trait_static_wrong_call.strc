trait Shape:
    func area(self) -> float
    static func make(x: int, y: int) -> self

type Circle:
    radius: float = 1.0

impl Shape for Circle:
    func area(self) -> float:
        return 3.14 * self.radius * self.radius
    static func make(radius: float) -> Circle:
        return Circle(radius)

// Should error: calling static method as instance
c = Circle()
print(c.make(5.0))