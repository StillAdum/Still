use random

type WfcTile:
    id: int
    name: str
    allowed_neighbors: [int] = []

type WfcGrid:
    width: int
    height: int
    cells: [int] = []

    func init_grid(self, default_val: int = -1):
        self.cells = []
        for i in range(self.width * self.height):
            push(self.cells, default_val)

    func get_cell(self, x: int, y: int) -> int:
        if x < 0 or x >= self.width or y < 0 or y >= self.height:
            return -1
        return self.cells[y * self.width + x]

    func set_cell(self, x: int, y: int, val: int):
        if x >= 0 and x < self.width and y >= 0 and y < self.height:
            self.cells[y * self.width + x] = val

type DungeonRoom:
    x: int
    y: int
    w: int
    h: int

func generate_bsp_dungeon(width: int, height: int, num_rooms: int = 4) -> [DungeonRoom]:
    rooms = []
    for i in range(num_rooms):
        rw = rand_range(6, 12)
        rh = rand_range(6, 10)
        rx = rand_range(2, width - rw - 2)
        ry = rand_range(2, height - rh - 2)
        push(rooms, DungeonRoom(rx, ry, rw, rh))
    return rooms
