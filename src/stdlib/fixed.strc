# Q16.16 fixed-point math: 16 bits integer, 16 bits fraction
# 1.0 is represented as 65536 (1 << 16)

func fixed_from_int(v: int) -> int:
    return v << 16

func fixed_to_int(v: int) -> int:
    return v >> 16

func fixed_from_float(v: float) -> int:
    return int(v * 65536.0)

func fixed_to_float(v: int) -> float:
    return float(v) / 65536.0

func fixed_mul(a: int, b: int) -> int:
    return (a * b) >> 16

func fixed_div(a: int, b: int) -> int:
    return (a << 16) // b

# Deterministic integer square root
func fixed_sqrt(v: int) -> int:
    if v <= 0:
        return 0
    # initial guess
    x = v
    y = (x + 1) // 2
    while y < x:
        x = y
        y = (x + v // x) // 2
    return x << 8
