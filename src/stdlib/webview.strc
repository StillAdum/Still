# webview — an embedded Edge (WebView2) browser for OAuth-style logins
#
# The classic use case: sign in to a website that has no usable API. Call
# login(start_url, poll_url, wanted): a real browser window opens (2FA,
# checkpoints and "remember me" all work), the runtime polls that site's
# cookies in the background, and as soon as the wanted one exists the
# window closes by itself. Read the captured values with cookie(name) —
# e.g. "sessionid" for Instagram.
#
# Requirements on Windows: WebView2Loader.dll next to the executable (the
# wingram release zip ships it) and the Edge WebView2 runtime, which every
# up-to-date Windows 10/11 has. On other platforms available() is false.
#
# Return codes of login():
#   1 = cookie captured (check cookie(name) for each one you need)
#   2 = the user closed the window without the cookie appearing
#   3 = webview unavailable (read last_error())

extern "C":
    func still_webview_available() -> int
    func still_webview_runtime_version() -> str
    func still_webview_last_error() -> str
    func still_webview_login(start_url: str, poll_url: str, wanted: str, timeout_ms: int, owner: int) -> int
    func still_webview_cookie(name: str) -> str
    func still_webview_cookie_string() -> str
    func still_webview_poll_count() -> int
    func still_webview_stage() -> int
    func still_webview_bounds_ok() -> int

func available() -> bool:
    return still_webview_available() == 1

func runtime_version() -> str:
    return still_webview_runtime_version()

func last_error() -> str:
    return still_webview_last_error()

# Blocking: opens the login window and returns when done (see codes above).
# `wanted` is the cookie name that ends the dialog once it exists
# (instagram logins wait for "sessionid"). `timeout_ms` > 0 auto-closes the
# window when the cookie has not appeared in time (CI probes); 0 waits
# until the user closes it.
func login(start_url: str, poll_url: str, wanted: str = "sessionid", timeout_ms: int = 0, owner: int = 0) -> int:
    return still_webview_login(start_url, poll_url, wanted, timeout_ms, owner)

# completed cookie poll round-trips of the last login() call — non-zero
# proves the webview + cookie machinery ran (diagnostics for probes when
# the target site itself is unreachable)
func poll_count() -> int:
    return still_webview_poll_count()

# how far the last login() got: 0 nothing, 1 environment created,
# 2 controller + cookie interface ready, 3 cookie polling started
func stage() -> int:
    return still_webview_stage()

# true once the WebView2 child window was attached and sized (put_Bounds
# succeeded). A blank login window usually means this is false even though
# stage() reached 2 or 3.
func bounds_ok() -> bool:
    return still_webview_bounds_ok() == 1

func cookie(name: str) -> str:
    return still_webview_cookie(name)

# all captured cookies as a "name=value; name=value" Cookie header string
func cookie_string() -> str:
    return still_webview_cookie_string()

# convenience: did a non-empty cookie with this name get captured?
func has_cookie(name: str) -> bool:
    return still_webview_cookie(name) != ""
