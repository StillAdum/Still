# media — image loading via GDI+ (real since v0.6.0) + video via MFPlay
#
# load() opens JPEG/PNG/GIF/BMP/ICO/TIFF files from disk and returns an opaque
# image handle (0 on failure). Pass the handle to gui.draw_image to render it
# inside a gui window. free() releases the handle when done. On other
# platforms available() is false and load() returns 0.
#
# video_* plays real MP4/H.264 video with sound inside a gui window
# (Media Foundation MFPlay on Windows; graceful no-op elsewhere):
#   video_play(path, win)   start a local file (returns false when the
#                           backend is missing — fall back to a poster)
#   video_rect(win, x, y, w, h)  position it in LOGICAL gui coordinates
#   video_state()           0 idle, 1 playing, 2 paused, 3 ended
#   video_rewind / video_pause / video_resume / video_stop

extern "C":
    func still_media_available() -> int
    func still_media_load(path: str) -> int
    func still_media_free(img: int)
    func still_media_width(img: int) -> int
    func still_media_height(img: int) -> int
    func still_media_video_available() -> int
    func still_media_video_play(path: str, hwnd: int) -> int
    func still_media_video_rect(gui_handle: int, x: float, y: float, w: float, h: float)
    func still_media_video_state() -> int
    func still_media_video_rewind()
    func still_media_video_pause()
    func still_media_video_resume()
    func still_media_video_stop()

func available() -> bool:
    return still_media_available() == 1

func load(path: str) -> int:
    return still_media_load(path)

func free(img: int):
    still_media_free(img)

func width(img: int) -> int:
    return still_media_width(img)

func height(img: int) -> int:
    return still_media_height(img)

func video_available() -> bool:
    return still_media_video_available() == 1

func video_play(path: str, win: int) -> bool:
    return still_media_video_play(path, win) == 1

func video_rect(win: int, x: float, y: float, w: float, h: float):
    still_media_video_rect(win, x, y, w, h)

func video_state() -> int:
    return still_media_video_state()

func video_rewind():
    still_media_video_rewind()

func video_pause():
    still_media_video_pause()

func video_resume():
    still_media_video_resume()

func video_stop():
    still_media_video_stop()

# ---------------------------------------------------------------------------
# Legacy capture stubs (kept for compatibility; these need real backend work
# and are not wired to the platform layer yet).

type WasapiCapture:
    sample_rate: int = 48000
    channels: int = 2
    is_capturing: bool = false

    func start_loopback(self) -> bool:
        self.is_capturing = true
        return true

    func stop_loopback(self):
        self.is_capturing = false

type ScreenCaptureSession:
    monitor_index: int = 0
    width: int = 1920
    height: int = 1080
    fps: int = 60
    active: bool = false

    func start(self) -> bool:
        self.active = true
        return true

    func stop(self):
        self.active = false
