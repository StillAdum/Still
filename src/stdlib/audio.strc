use math
use vec

type SoundSource:
    id: str
    pos: Vec3
    volume: float = 1.0
    pitch: float = 1.0
    looping: bool = false
    is_playing: bool = false

type AudioListener:
    pos: Vec3
    forward: Vec3
    up: Vec3

type AudioMixer:
    listener: AudioListener
    sources: [SoundSource]
    master_volume: float = 1.0

    func set_listener(self, x: float, y: float, z: float):
        self.listener = AudioListener(Vec3(x, y, z), Vec3(0.0, 0.0, -1.0), Vec3(0.0, 1.0, 0.0))

    func play_sound_3d(self, id: str, x: float, y: float, z: float, vol: float = 1.0) -> SoundSource:
        src = SoundSource(id, Vec3(x, y, z), vol, 1.0, false, true)
        push(self.sources, src)
        return src

    func calculate_spatial(self, src: SoundSource) -> (float, float):
        diff = src.pos.sub(self.listener.pos)
        dist = diff.length()
        if dist < 0.1:
            dist = 0.1
        attenuation = 1.0 / (1.0 + 0.1 * dist)
        vol = src.volume * attenuation * self.master_volume
        right = self.listener.forward.cross(self.listener.up)
        pan = diff.normalized().dot(right)
        return (pan, vol)

func make_audio_mixer() -> AudioMixer:
    lst = AudioListener(Vec3(0.0, 0.0, 0.0), Vec3(0.0, 0.0, -1.0), Vec3(0.0, 1.0, 0.0))
    return AudioMixer(lst, [], 1.0)

func synth_sine_wave(freq: float, duration_secs: float, sample_rate: int = 44100) -> [float]:
    samples = []
    total_samples = int(duration_secs * float(sample_rate))
    for i in range(total_samples):
        t = float(i) / float(sample_rate)
        sample = sin(2.0 * 3.1415926535 * freq * t)
        push(samples, sample)
    return samples

func synth_noise(duration_secs: float, sample_rate: int = 44100) -> [float]:
    samples = []
    total_samples = int(duration_secs * float(sample_rate))
    for i in range(total_samples):
        val = float((i * 1103515245 + 12345) % 65536) / 32768.0 - 1.0
        push(samples, val)
    return samples
