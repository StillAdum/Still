func read_lines(path: str) -> [str]:
    data = read_file(path)
    lines = data.split("\n")
    if len(lines) > 0:
        if lines[len(lines) - 1] == "":
            pop(lines)
    return lines

func write_lines(path: str, lines: [str]):
    out = "\n".join(lines)
    if len(lines) > 0:
        out = out + "\n"
    write_file(path, out)

# Create a directory (single call; intermediate levels are created too as
# long as they are walked left to right, "cache/img" style). Returns true
# when the directory exists afterwards.
extern "C":
    func still_dir_make(path: str) -> int

func make_dir(path: str) -> bool:
    return still_dir_make(path) == 1
