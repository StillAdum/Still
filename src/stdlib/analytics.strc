type AnalyticsEvent:
    event_name: str
    user_id: str
    timestamp: float

type AnalyticsClient:
    app_id: str
    event_queue: [AnalyticsEvent]

    func track(self, event_name: str, user_id: str):
        push(self.event_queue, AnalyticsEvent(event_name, user_id, clock()))

    func flush(self) -> int:
        count = len(self.event_queue)
        self.event_queue = []
        return count

func make_analytics_client(app_id: str) -> AnalyticsClient:
    return AnalyticsClient(app_id, [])
