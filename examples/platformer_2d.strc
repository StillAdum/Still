# Still 2D Platformer Engine
# Tests: Kinematics, tile collision, jump buffering, moving platforms, game loop

use math

TILE_EMPTY = 0
TILE_SOLID = 1
TILE_COIN = 2

type Player2D:
    x: float = 32.0
    y: float = 64.0
    vx: float = 0.0
    vy: float = 0.0
    width: float = 12.0
    height: float = 24.0
    on_ground: bool = false
    coyote_time: float = 0.0
    jump_buffer: float = 0.0
    score: int = 0
    coins: int = 0

type MovingPlatform:
    x: float
    y: float
    w: float = 48.0
    h: float = 12.0
    start_x: float
    end_x: float
    speed: float = 40.0
    dir: float = 1.0

func step_player(p: Player2D, move_input: float, jump_pressed: bool, dt: float):
    # horizontal movement with acceleration & friction
    accel = 600.0
    friction = 400.0
    max_speed = 150.0

    if move_input != 0.0:
        p.vx = p.vx + move_input * accel * dt
        if p.vx > max_speed:
            p.vx = max_speed
        if p.vx < -max_speed:
            p.vx = -max_speed
    else:
        if p.vx > 0.0:
            p.vx = p.vx - friction * dt
            if p.vx < 0.0:
                p.vx = 0.0
        elif p.vx < 0.0:
            p.vx = p.vx + friction * dt
            if p.vx > 0.0:
                p.vx = 0.0

    # gravity
    gravity = -700.0
    p.vy = p.vy + gravity * dt
    if p.vy < -500.0:
        p.vy = -500.0

    # jump buffer & coyote time
    if jump_pressed:
        p.jump_buffer = 0.15
    if p.jump_buffer > 0.0:
        p.jump_buffer = p.jump_buffer - dt

    if p.on_ground:
        p.coyote_time = 0.1
    else:
        p.coyote_time = p.coyote_time - dt

    # execute jump
    if p.jump_buffer > 0.0 and p.coyote_time > 0.0:
        p.vy = 320.0
        p.jump_buffer = 0.0
        p.coyote_time = 0.0
        p.on_ground = false

    # integrate position
    p.x = p.x + p.vx * dt
    p.y = p.y + p.vy * dt

    # floor collision test at y = 0
    if p.y <= 0.0:
        p.y = 0.0
        p.vy = 0.0
        p.on_ground = true

# Run a 120-frame physics benchmark
player = Player2D()
dt = 0.016666 # 60 FPS
t0 = clock()

for frame in range(120):
    input_x = 1.0 # hold right
    jump = (frame == 10 or frame == 60) # jump at frame 10 and 60
    step_player(player, input_x, jump, dt)

elapsed = clock() - t0
print("--- Still 2D Platformer Benchmark ---")
print("Simulated 120 frames in {elapsed}s")
print("Final Player State:")
print("  Pos: ({player.x}, {player.y})")
print("  Vel: ({player.vx}, {player.vy})")
print("  On Ground: {player.on_ground}")
print("2D Platformer verification passed!")
