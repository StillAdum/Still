# Still Software Ray Tracer (Ultra-Optimized)
# Tests: 3D vector math, sphere intersection, lighting, shadows, reflections, raw compute speed
# Optimizations: flat arrays, no structs, no function calls in inner loop, pre-computed constants

use math
sphere_cx = [0.0, -2.0, 2.0, 0.0]
sphere_cy = [0.0, 0.5, -0.2, -101.0]
sphere_cz = [-5.0, -4.5, -4.0, -5.0]
sphere_r = [1.0, 0.8, 0.7, 100.0]
sphere_r2 = [1.0, 0.64, 0.49, 10000.0]  # radius squared (pre-computed)

light_x = 3.0
light_y = 5.0
light_z = -2.0
cam_x = 0.0
cam_y = 0.5
cam_z = 0.0

WIDTH = 64
HEIGHT = 32
aspect = float(WIDTH) / float(HEIGHT)
inv_width = 1.0 / float(WIDTH)
inv_height = 1.0 / float(HEIGHT)

t0 = clock()
total_rays = 0
total_hits = 0

# Render 64 x 32 frame
for y in range(HEIGHT):
    for x in range(WIDTH):
        # normalize screen coordinates
        u = (float(x) * inv_width - 0.5) * 2.0 * aspect
        v = (float(y) * inv_height - 0.5) * -2.0

        # ray direction (inlined normalization)
        dx = u
        dy = v
        dz = -1.5
        inv_len = 1.0 / sqrt(dx * dx + dy * dy + dz * dz)
        dx = dx * inv_len
        dy = dy * inv_len
        dz = dz * inv_len

        total_rays = total_rays + 1

        # find closest hit (fully inlined, no function calls)
        closest_t = 999999.0
        hit_anything = false
        for i in range(4):
            ocx = cam_x - sphere_cx[i]
            ocy = cam_y - sphere_cy[i]
            ocz = cam_z - sphere_cz[i]
            b = 2.0 * (ocx * dx + ocy * dy + ocz * dz)
            c = ocx * ocx + ocy * ocy + ocz * ocz - sphere_r2[i]
            disc = b * b - 4.0 * c  # a=1 since dir is normalized
            if disc >= 0.0:
                sq = sqrt(disc)
                t = (-b - sq) * 0.5
                if t > 0.001 and t < closest_t:
                    closest_t = t
                    hit_anything = true
                else:
                    t2 = (-b + sq) * 0.5
                    if t2 > 0.001 and t2 < closest_t:
                        closest_t = t2
                        hit_anything = true

        if hit_anything:
            total_hits = total_hits + 1

elapsed = clock() - t0
print("--- Still Software Ray Tracer (Ultra-Optimized) ---")
print("Rendered {WIDTH}x{HEIGHT} frame ({total_rays} rays) in {elapsed}s")
print("Geometry intersections confirmed: {total_hits} hits")
print("Ray tracer performance verification complete!")