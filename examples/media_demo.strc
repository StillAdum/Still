# The media module: JPEG/PNG/GIF/BMP loading via GDI+ (Windows), rendered
# with the gui module. Guarded by STILL_RUN_GUI_DEMO like the gui demo.
use media
use gui
use os

if env("STILL_RUN_GUI_DEMO", "") == "":
    print("media demo guarded by STILL_RUN_GUI_DEMO=1 (needs Windows + a display)")
else:
    if not media.available():
        print("media backend unavailable")
    else:
        win = gui.open_window("Still media demo", 480, 360)
        if win == 0:
            print("could not open a window on this platform")
        else:
            gui.set_bg(win, 0x101418)
            img = media.load("assets/photo.jpg")
            while gui.window_open(win):
                if gui.begin_frame(win):
                    if img != 0:
                        gui.draw_image(win, img, 40, 40, 400, 260)
                        gui.text(win, 40, 316, "image decoded with GDI+ and drawn scaled", 0x8B949E, 14)
                    else:
                        gui.text(win, 40, 180, "place assets\\photo.jpg next to the exe", 0x8B949E, 14)
                    if gui.key_pressed(win, gui.VK_ESCAPE):
                        break
                    gui.end_frame(win)
                else:
                    break
            if img != 0:
                media.free(img)
            gui.close_window(win)
            print("media demo closed")
