# The net module: real HTTPS through WinHTTP (Windows). On other platforms
# available() is false and the demo skips gracefully.
#
# Writes each stage to net_diag.log (and prints) so a crash in the C backend
# leaves the last reached stage on disk for CI failure reporting.

use net
use io

extern "C":
    func fflush(f: int) -> int
    func putenv(s: str) -> int

func stage(label: str):
    print("stage:", label)
    write_file("net_diag.log", label + "\n")

if not net.available():
    stage("unavailable - skipping (needs Windows WinHTTP)")
else:
    stage("available ok")
    putenv("STILL_NET_TRACE=1")
    stage("request GET api.github.com/repos/StillAdum/Still")
    r = net.get("https://api.github.com/repos/StillAdum/Still", "User-Agent: still-demo", 15000)
    stage("request returned ok={r.ok}")
    if r.ok:
        stage("status={r.status} ctype={r.content_type} body={len(r.body)}B")
    else:
        stage("failed: {r.error}")
    stage("done")
